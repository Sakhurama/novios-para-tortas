# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se commitea.

# ID de medición de Google Analytics 4 (Administrar → Flujos de datos → Web).
# Sin esta variable la analítica sencillamente no se inyecta, y el sitio
# funciona igual. Tampoco se activa en `npm run dev`, solo en build de producción.
PUBLIC_GA_ID=G-XXXXXXXXXX
