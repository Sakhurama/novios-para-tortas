---
import Layout from '../layouts/Layout.astro';
import NavBarMorado from '../components/NavBarMorado.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Catalog from '../components/Catalog.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <NavBarMorado />
  <main id="contenido">
    <Hero />
    <TrustBar />
    <Catalog />
    <HowItWorks />
    <Gallery />
    <Story />
    {/* <Testimonials /> — fuera hasta tener testimonios reales de clientas.
        Los tres que había (Laura & Andrés, Valentina & Camilo, Daniela &
        Julián) eran de relleno. El componente sigue en components/: para
        volver a enchufarlo basta con esta línea y su import. */}
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <WhatsAppButton/>
</Layout>
