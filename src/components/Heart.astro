---
// Corazón de marca reutilizable (elemento identitario, rojo #DD2530).
// Úsalo como viñeta, separador o micro-detalle. Sutil por defecto.
interface Props {
  size?: number;
  class?: string;
  color?: string;
  beat?: boolean;
  filled?: boolean;
}

const {
  size = 16,
  class: className = '',
  color = 'currentColor',
  beat = false,
  filled = true,
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? color : 'none'}
  stroke={color}
  stroke-width={filled ? 0 : 1.75}
  aria-hidden="true"
  class:list={['inline-block align-middle', beat && 'heart-beat', className]}
>
  <path
    d="M12 21s-6.716-4.35-9.428-8.06C.86 10.29 1.32 6.9 3.9 5.35c2.02-1.21 4.51-.62 5.86 1.02L12 8.6l2.24-2.23c1.35-1.64 3.84-2.23 5.86-1.02 2.58 1.55 3.04 4.94 1.33 7.59C18.716 16.65 12 21 12 21z"
  />
</svg>
