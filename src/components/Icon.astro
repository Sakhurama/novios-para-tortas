---
// Iconos de línea de la marca. Trazo fino (1.5) y remates redondeados, para que
// acompañen la tipografía serif sin competir con ella.
// Complementan a Heart.astro: el corazón sigue siendo el sello identitario,
// pero deja de ser el único recurso gráfico repetido en toda la web.
interface Props {
  name: 'hand' | 'brush' | 'package' | 'rings';
  size?: number;
  class?: string;
  color?: string;
}

const { name, size = 20, class: className = '', color = 'currentColor' } = Astro.props;

// Cada icono es el interior del <svg> (viewBox 0 0 24 24). El trazo y el color
// se heredan del <svg> contenedor, salvo detalles puntuales como el corazón
// del icono de argollas, que va relleno en rojo de acento.
const icons: Record<Props['name'], string> = {
  // Mano artesana: lo hecho pieza por pieza.
  hand: `
    <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
    <path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2" />
    <path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8" />
    <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
  `,
  // Pincel: la personalización, el acabado pintado a mano.
  brush: `
    <path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08" />
    <path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z" />
  `,
  // Caja: el envío protegido a todo el país.
  package: `
    <path d="m7.5 4.27 9 5.15" />
    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
    <path d="m3.3 7 8.7 5 8.7-5" />
    <path d="M12 22V12" />
  `,
  // Argollas entrelazadas con un corazón encima: la boda, con el sello de marca.
  rings: `
    <path fill="#DD2530" stroke="none" d="M15.5 8.6c-2.6-1.9-3.6-3.2-3.6-4.5 0-1.2 1-2 2-2 .8 0 1.4.4 1.6 1 .2-.6.8-1 1.6-1 1 0 2 .8 2 2 0 1.3-1 2.6-3.6 4.5z" />
    <path d="M3 15a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0" />
    <path d="M10 15a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0" />
  `,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['inline-block align-middle', className]}
>
  <Fragment set:html={icons[name]} />
</svg>
