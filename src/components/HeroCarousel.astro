---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { heroImageAlts, HERO_ALT_FALLBACK, HERO_PLACEHOLDER_SLIDES } from '../config';
import Heart from './Heart.astro';

// Las fotos entran solas al soltarlas en src/assets/hero/ — ver el .gitkeep.
const modules = import.meta.glob<ImageMetadata>(
  '../assets/hero/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
);

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, image]) => {
    const file = path.split('/').pop() ?? '';
    return { image, alt: heroImageAlts[file] ?? HERO_ALT_FALLBACK };
  });

const hasPhotos = photos.length > 0;
const count = hasPhotos ? photos.length : HERO_PLACEHOLDER_SLIDES;
const showControls = count > 1;
---

<div
  class="relative lg:h-full"
  data-hero-carousel
  role="region"
  aria-roledescription="carrusel"
  aria-label="Fotos de novios para torta"
>
  <div
    data-track
    class:list={[
      // En móvil manda la proporción 4/5; en escritorio manda el alto que le
      // deje el Hero, que está limitado a una pantalla.
      'hero-track flex aspect-[4/5] w-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden rounded-[2rem] lg:aspect-auto lg:h-full',
      !hasPhotos && 'border border-dashed border-brand/25 bg-brand-soft',
    ]}
  >
    {
      Array.from({ length: count }).map((_, i) => (
        <div
          data-slide
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${count}`}
          class="relative w-full shrink-0 snap-center"
        >
          {hasPhotos ? (
            <Image
              src={photos[i].image}
              alt={photos[i].alt}
              widths={[400, 600, 900]}
              sizes="(min-width: 1024px) 40vw, 92vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-center text-brand/40">
              <div>
                <Heart size={44} color="#DD2530" class="mx-auto opacity-40" />
                <p class="mt-3 text-sm font-medium uppercase tracking-widest">Foto {i + 1}</p>
                <p class="mt-1 text-xs">Novios sobre la torta</p>
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  {
    showControls && (
      <>
        {/* Flechas */}
        <button
          type="button"
          data-prev
          aria-label="Foto anterior"
          class="hero-ctrl absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-brand shadow-sm ring-1 ring-brand/10 backdrop-blur transition-colors hover:bg-white"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>

        <button
          type="button"
          data-next
          aria-label="Foto siguiente"
          class="hero-ctrl absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-brand shadow-sm ring-1 ring-brand/10 backdrop-blur transition-colors hover:bg-white"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>

        {/* Puntos */}
        <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full bg-white/75 px-3 py-2 shadow-sm ring-1 ring-brand/10 backdrop-blur">
          {Array.from({ length: count }).map((_, i) => (
            <button
              type="button"
              data-dot
              aria-label={`Ir a la foto ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
              class="hero-ctrl hero-dot h-2 rounded-full bg-brand/30 transition-all"
            />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  /* El track se desplaza, pero sin barra visible */
  .hero-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-dot {
    width: 0.5rem;
  }
  .hero-dot[aria-current='true'] {
    width: 1.5rem;
    background-color: var(--color-brand);
  }

  /* El foco global es morado y estos controles van sobre la foto */
  .hero-ctrl:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--color-brand);
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const AUTOPLAY_MS = 5000;

  // Se monta por instancia (no por id) para que el componente pueda repetirse.
  document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    if (slides.length < 2) return;

    let index = 0;
    let timer: number | undefined;
    let hovering = false;
    let focused = false;

    function markActive(i: number) {
      index = i;
      dots.forEach((dot, n) => {
        if (n === i) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function goTo(i: number) {
      const next = (i + slides.length) % slides.length;
      track!.scrollTo({
        left: next * track!.clientWidth,
        behavior: reduced.matches ? 'auto' : 'smooth',
      });
      markActive(next);
    }

    // El punto activo se deriva del scroll real: tras un swipe manual, el
    // índice interno no basta para saber qué slide se está viendo.
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) markActive(slides.indexOf(entry.target as HTMLElement));
        });
      },
      { root: track, threshold: 0.6 }
    );
    slides.forEach((slide) => observer.observe(slide));

    function stop() {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    }

    function start() {
      stop();
      if (reduced.matches || hovering || focused || document.hidden) return;
      timer = window.setInterval(() => goTo(index + 1), AUTOPLAY_MS);
    }

    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Pausa mientras alguien está mirando o navegando el carrusel.
    // Solo en dispositivos con hover real: en táctil, `pointerenter` dispara al
    // tocar y `pointerleave` puede no llegar nunca, dejando el autoplay muerto.
    if (window.matchMedia('(hover: hover)').matches) {
      root.addEventListener('pointerenter', () => {
        hovering = true;
        stop();
      });
      root.addEventListener('pointerleave', () => {
        hovering = false;
        start();
      });
    }

    root.addEventListener('focusin', () => {
      focused = true;
      stop();
    });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      focused = false;
      start();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reduced.addEventListener('change', start);

    // Al cambiar el ancho, el offset guardado deja de ser válido
    window.addEventListener('resize', () => {
      track.scrollTo({ left: index * track.clientWidth, behavior: 'auto' });
    });

    start();
  });
</script>
