---
import Heart from './Heart.astro';
import SectionTitle from './SectionTitle.astro';

const reasons = [
  {
    title: 'Hecho a mano, con alma',
    desc: 'Nada de moldes en serie. Cada figura se modela y pinta pieza por pieza, con la dedicación de una familia artesana.',
  },
  {
    title: 'Idénticos a ustedes',
    desc: 'Nos cuentan cómo son y recreamos peinado, traje, vestido, colores y esos detalles que los hacen únicos.',
  },
  {
    title: 'Un recuerdo que perdura',
    desc: 'Materiales resistentes pensados para conservarse. El adorno de hoy será el recuerdo de toda la vida.',
  },
  {
    title: '20 años de confianza',
    desc: 'Dos décadas coronando tortas de matrimonio en toda Colombia. La experiencia se nota en cada acabado.',
  },
];
---

<section id="por-que" class="bg-cream">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Por qué elegirnos"
      title="Más que un adorno, <span class='italic'>un recuerdo</span>"
      subtitle="Elegir Novios para Tortas es confiar en manos con experiencia que cuidan cada detalle de tu día más especial."
    />

    <div data-reveal-group class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        reasons.map((r) => (
          <div class="flex gap-4 rounded-2xl border border-brand-soft bg-white p-7 shadow-sm">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-soft">
              <Heart size={20} color="#DD2530" />
            </span>
            <div>
              <h3 class="font-serif text-xl font-semibold text-brand">{r.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">{r.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
