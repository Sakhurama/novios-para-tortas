---
import Icon from './Icon.astro';

// Cada pilar lleva su propio icono de línea (ver Icon.astro) en lugar de
// repetir el corazón cuatro veces.
const pillars = [
  { icon: 'hand', title: 'Hechos a mano', desc: 'En porcelanicrón, pieza por pieza, en nuestro taller.' },
  // "Personalización total" es palabra de folleto. Lo que de verdad compra la
  // clienta es el parecido, y el parecido se demuestra nombrando cosas.
  { icon: 'brush', title: 'Se parecen a ustedes', desc: 'Su peinado, su vestido, el traje y hasta la mascota.' },
  // "Empaque seguro" describe; "si algo pasa, lo resolvemos" compromete. La
  // diferencia importa: el miedo a que la pieza llegue rota es lo que más
  // frena la compra de algo frágil, hecho a mano y pagado por adelantado.
  { icon: 'package', title: 'Envíos a toda Colombia', desc: 'Empacamos con mucho cuidado y amor.' },
  // Antes decía "Miles de bodas felices": una cifra que nadie puede comprobar
  // y que no le pide nada al visitante. El plazo sí: le da una razón para
  // escribir hoy en lugar de dejarlo para después, que es donde se pierden
  // casi todos los pedidos de algo con fecha límite.
  { icon: 'aprobado', title: 'Listos en 6 días hábiles', desc: 'Escríbenos con tres semanas y aseguras tu fecha.' },
] as const;
---

<section class="border-y border-brand-soft bg-cream">
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <!-- Pilares de confianza -->
    <div data-reveal-group class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p) => (
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white ring-1 ring-brand-soft">
              <Icon name={p.icon} size={20} color="#490A41" />
            </span>
            <div>
              <p class="font-serif text-lg font-semibold text-brand">{p.title}</p>
              <p class="mt-1 text-sm text-ink/60">{p.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
