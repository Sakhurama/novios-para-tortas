---
import { waLink } from '../config';
import Heart from './Heart.astro';

const links = [
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#por-que', label: 'Por qué elegirnos' },
  { href: '#historia', label: 'Nuestra historia' },
  { href: '#galeria', label: 'Galería' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header class="navbar-morado sticky top-0 z-40 w-full border-b border-white/15 bg-brand backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
    <!-- Logo -->
    <a href="#inicio" class="flex items-center" aria-label="Novios para Tortas — inicio">
      <img
        src="/logo-blanco.png"
        alt="Novios para Tortas"
        width="592"
        height="226"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    <!-- Enlaces (desktop) -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-sm font-medium text-white/75 transition-colors hover:text-white"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Acciones (CTA + hamburguesa) -->
    <div class="flex items-center gap-2">
      <!-- CTA -->
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-medium text-brand shadow-sm transition-all hover:bg-brand-soft hover:shadow-md"
      >
        <Heart size={13} color="#DD2530" />
        <span class="hidden sm:inline">Cotiza por WhatsApp</span>
        <span class="sm:hidden">Cotizar</span>
      </a>

      <!-- Botón hamburguesa (solo móvil/tablet) -->
      <button
        type="button"
        id="nav-toggle-morado"
        aria-label="Abrir menú"
        aria-controls="mobile-menu-morado"
        aria-expanded="false"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-white transition-colors hover:bg-white/15 lg:hidden"
      >
        <!-- Ícono hamburguesa -->
        <svg class="nav-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <!-- Ícono cerrar (oculto por defecto) -->
        <svg class="nav-icon-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú móvil desplegable -->
  <div
    id="mobile-menu-morado"
    class="hidden overflow-hidden border-t border-white/15 bg-brand-light lg:hidden"
  >
    <ul class="mx-auto flex max-w-7xl flex-col px-5 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link
              class="flex items-center gap-2 border-b border-white/15 py-3.5 font-serif text-lg text-white transition-colors hover:text-white/70"
            >
              <Heart size={13} color="#DD2530" />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  /* El foco global es morado: sobre este fondo no se vería */
  .navbar-morado :where(a, button):focus-visible {
    outline-color: #ffffff;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle-morado');
  const menu = document.getElementById('mobile-menu-morado');
  const iconOpen = toggle?.querySelector('.nav-icon-open');
  const iconClose = toggle?.querySelector('.nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Cierra el menú al elegir un enlace
  menu?.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Cierra al pasar a escritorio (evita que quede abierto tras rotar/redimensionar)
  const desktop = window.matchMedia('(min-width: 1024px)');
  desktop.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
