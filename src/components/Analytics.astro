---
// Google Analytics 4.
//
// Doble guarda a propósito:
//  · `PROD` → `npm run dev` no ensucia las métricas con visitas de desarrollo.
//  · ID presente → sin la variable de entorno no se inyecta nada y el build no
//    se rompe. Así el sitio se puede desplegar antes de tener la cuenta creada.
//
// El ID se lee de `PUBLIC_GA_ID` (ver .env.example). Lleva el prefijo PUBLIC_
// porque tiene que llegar al navegador; no es un secreto, va visible en el HTML
// de cualquier sitio con GA.
const gaId = import.meta.env.PUBLIC_GA_ID;
const enabled = import.meta.env.PROD && Boolean(gaId);
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )
}
