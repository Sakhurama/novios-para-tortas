---
import { waLink } from '../config';
import Heart from './Heart.astro';

const links = [
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#por-que', label: 'Por qué elegirnos' },
  { href: '#historia', label: 'Nuestra historia' },
  { href: '#galeria', label: 'Galería' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-brand-soft/70 bg-white/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
    <!-- Logo (placeholder) -->
    <a href="#inicio" class="flex items-center gap-2" aria-label="Novios para Tortas — inicio">
      <span
        class="flex h-11 w-11 items-center justify-center rounded-full border border-dashed border-brand/40 bg-brand-soft text-[10px] font-medium uppercase tracking-wide text-brand/60"
      >
        Logo
      </span>
      <span class="hidden font-serif text-xl leading-none text-brand sm:block">
        Novios <span class="italic">para Tortas</span>
        <Heart size={11} color="#DD2530" class="ml-0.5 -translate-y-1.5" />
      </span>
    </a>

    <!-- Enlaces (desktop) -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-sm font-medium text-ink/70 transition-colors hover:text-brand"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Acciones (CTA + hamburguesa) -->
    <div class="flex items-center gap-2">
      <!-- CTA -->
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-all hover:bg-brand-light hover:shadow-md"
      >
        <Heart size={13} color="#ffffff" />
        <span class="hidden sm:inline">Cotiza por WhatsApp</span>
        <span class="sm:hidden">Cotizar</span>
      </a>

      <!-- Botón hamburguesa (solo móvil/tablet) -->
      <button
        type="button"
        id="nav-toggle"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-brand transition-colors hover:bg-brand-soft lg:hidden"
      >
        <!-- Ícono hamburguesa -->
        <svg class="nav-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <!-- Ícono cerrar (oculto por defecto) -->
        <svg class="nav-icon-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú móvil desplegable -->
  <div
    id="mobile-menu"
    class="hidden overflow-hidden border-t border-brand-soft bg-white lg:hidden"
  >
    <ul class="mx-auto flex max-w-7xl flex-col px-5 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link
              class="flex items-center gap-2 border-b border-brand-soft/60 py-3.5 font-serif text-lg text-brand transition-colors hover:text-accent"
            >
              <Heart size={13} color="#DD2530" />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('.nav-icon-open');
  const iconClose = toggle?.querySelector('.nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Cierra el menú al elegir un enlace
  menu?.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Cierra al pasar a escritorio (evita que quede abierto tras rotar/redimensionar)
  const desktop = window.matchMedia('(min-width: 1024px)');
  desktop.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
