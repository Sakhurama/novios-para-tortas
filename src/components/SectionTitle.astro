---
import Heart from './Heart.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  onDark?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', onDark = false } = Astro.props;
const isCenter = align === 'center';
---

<div class:list={[isCenter ? 'text-center mx-auto max-w-2xl' : 'text-left max-w-2xl']}>
  {
    eyebrow && (
      <span
        class:list={[
          'inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest',
          onDark ? 'text-white/70' : 'text-brand/70',
          isCenter && 'justify-center',
        ]}
      >
        <Heart size={12} color="#DD2530" />
        {eyebrow}
      </span>
    )
  }
  <h2
    class:list={[
      'mt-3 font-serif text-4xl font-semibold leading-tight sm:text-5xl',
      onDark ? 'text-white' : 'text-brand',
    ]}
  >
    <Fragment set:html={title} />
  </h2>
  {
    subtitle && (
      <p class:list={['mt-4 text-lg leading-relaxed', onDark ? 'text-white/70' : 'text-ink/60']}>
        {subtitle}
      </p>
    )
  }
</div>
