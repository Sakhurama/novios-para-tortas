---
import { isRealProfile, navLinks, site, waLink } from '../config';
import Heart from './Heart.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-soft bg-cream">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div class="lg:col-span-2">
        <div class="flex items-center">
          <img
            src="/logo-morado.png"
            alt="Novios para Tortas"
            width="592"
            height="226"
            class="h-12 w-auto"
            loading="lazy"
          />
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink/60">
          Llevamos {site.yearsInMarket} años modelando a mano los novios que van encima
          de la torta, desde nuestro taller en {site.city} para toda Colombia. Uno por
          uno, parecidos a quienes se casan.
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-brand">Explora</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-ink/60 transition-colors hover:text-brand">
                  {'labelLong' in l ? l.labelLong : l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-brand">Contáctanos</h3>
        <ul class="mt-4 space-y-2 text-sm text-ink/60">
          <li>
            <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition-colors hover:text-brand">
              <WhatsAppIcon size={14} color="#25D366" /> WhatsApp
            </a>
          </li>
          {/* Solo si apuntan a un perfil de verdad. Un enlace a la portada de
              Instagram saca de la página a alguien que estaba a punto de
              escribir y lo deja en un sitio que no habla del negocio: es peor
              que no tener enlace. Misma comprobación que usa el sameAs del
              esquema (ver isRealProfile en config.ts). */}
          {isRealProfile(site.instagram) && (
            <li>
              <a href={site.instagram} target="_blank" rel="noopener" class="transition-colors hover:text-brand">Instagram</a>
            </li>
          )}
          {isRealProfile(site.facebook) && (
            <li>
              <a href={site.facebook} target="_blank" rel="noopener" class="transition-colors hover:text-brand">Facebook</a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-brand-soft pt-6 text-center sm:flex-row sm:text-left">
      <p class="text-xs text-ink/50">© {year} {site.name}. Todos los derechos reservados.</p>
      <p class="inline-flex items-center gap-1.5 text-xs text-ink/50">
        Hecho a mano en {site.city} <Heart size={12} color="#DD2530" />
      </p>
    </div>
  </div>
</footer>
