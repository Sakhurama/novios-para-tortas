---
import { waLink, site } from '../config';
import Heart from './Heart.astro';
import HeroCarousel from './HeroCarousel.astro';
---

<section id="inicio" class="relative bg-white">
  <!-- Corazones decorativos de fondo (muy sutiles).
       El recorte vive aquí y no en la sección: así los corazones con offset
       negativo no generan scroll horizontal, pero el texto nunca se corta si
       necesita más alto del que cabe en pantalla. -->
  <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden" aria-hidden="true">
    <Heart size={120} color="#DD2530" class="absolute -right-6 top-10 opacity-[0.04]" />
    <Heart size={70} color="#490A41" class="absolute left-8 bottom-16 opacity-[0.05]" />
    <Heart size={40} color="#DD2530" class="absolute left-1/3 top-24 opacity-[0.05]" />
  </div>

  <!-- En escritorio el Hero ocupa como mucho una pantalla: 100svh menos el
       navbar sticky (py-4 + logo h-12 = 5rem). Es min-h y no h fija para que,
       si el texto llegara a necesitar más alto, la sección crezca en vez de
       recortarlo. En móvil es una columna y no aplica. -->
  <div
    class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 lg:min-h-[calc(100svh-5rem)] lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-12"
  >
    <!-- Texto -->
    <div class="max-w-xl">
      <h1 class="mt-6 font-serif text-5xl font-semibold leading-[1.05] text-brand sm:text-6xl lg:text-7xl">
        El detalle que corona
        <span class="italic"> el amor</span> de tu boda
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        Fabricamos <strong class="font-semibold text-ink">a mano</strong> las figuras de
        novios que hacen única tu torta de matrimonio. Cada pieza, pensada para
        parecerse a ustedes y guardarse como recuerdo para siempre.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-medium text-white shadow-md transition-all hover:bg-brand-light hover:shadow-lg"
        >
          <Heart size={16} color="#ffffff" />
          Cotiza tu novio ideal
        </a>
        <a
          href="#catalogo"
          class="inline-flex items-center justify-center rounded-full border border-brand/25 px-7 py-3.5 text-base font-medium text-brand transition-colors hover:bg-brand-soft"
        >
          Ver el catálogo
        </a>
      </div>

      <p class="mt-6 flex items-center gap-2 text-sm text-ink/50">
        <Heart size={13} color="#DD2530" />
        Hecho a mano en {site.city} · Envíos a todo el país
      </p>
    </div>

    <!-- Carrusel de fotos.
         Alto fijo en escritorio = pantalla - navbar (5rem) - py-12 (6rem),
         para que la foto entre completa sin empujar la sección. -->
    <div class="relative lg:h-[calc(100svh-11rem)] lg:max-h-[45rem]">
      <HeroCarousel />

      <!-- Sello flotante "20 años" (fuera del carrusel: sobresale del marco) -->
      <div
        class="absolute -bottom-5 -right-5 flex h-28 w-28 flex-col items-center justify-center rounded-full bg-white text-center shadow-xl ring-1 ring-brand/10 sm:h-32 sm:w-32"
      >
        <span class="font-serif text-3xl font-semibold leading-none text-brand sm:text-4xl">{site.yearsInMarket}</span>
        <span class="mt-1 text-[10px] font-medium uppercase tracking-widest text-ink/60">años de<br />experiencia</span>
        <Heart size={13} color="#DD2530" beat class="mt-1" />
      </div>
    </div>
  </div>
</section>
