---
import Heart from './Heart.astro';
import SectionTitle from './SectionTitle.astro';

const testimonials = [
  {
    quote:
      '¡Quedaron idénticos a nosotros! Todos en la boda preguntaban dónde los conseguimos. Un recuerdo que vamos a guardar para siempre.',
    name: 'Laura & Andrés',
    place: 'Bogotá',
  },
  {
    quote:
      'El trato fue cercanísimo por WhatsApp y cumplieron con los tiempos. La calidad del trabajo a mano se nota muchísimo.',
    name: 'Valentina & Camilo',
    place: 'Medellín',
  },
  {
    quote:
      'Pedimos algo muy personalizado con nuestra mascota incluida y lo lograron perfecto. 20 años de experiencia se sienten.',
    name: 'Daniela & Julián',
    place: 'Cali',
  },
];

// Con un solo testimonio no hay nada que pasar: se muestra la tarjeta y ya.
const showControls = testimonials.length > 1;
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Parejas felices"
      title="Historias que <span class='italic'>coronamos</span>"
      subtitle="Nada nos enorgullece más que ser parte del día más importante de nuestras parejas."
    />

    {/* El carrusel entra como un solo bloque: animar cada testimonio por
        separado pelearía con su propio desplazamiento. */}
    <div
      data-reveal
      class="mx-auto mt-14 max-w-3xl"
      data-testimonials
      role="region"
      aria-roledescription="carrusel"
      aria-label="Testimonios de nuestras parejas"
    >
      {/* Un testimonio a la vez: la cita gana presencia y se lee de un tirón. */}
      <div data-track class="tst-track flex snap-x snap-mandatory overflow-x-auto overflow-y-hidden">
        {
          testimonials.map((t, i) => (
            <div
              data-slide
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${testimonials.length}`}
              class="w-full shrink-0 snap-center px-1 py-1"
            >
              <figure class="flex h-full flex-col items-center rounded-2xl border border-brand-soft bg-cream p-8 text-center shadow-sm sm:p-10">
                <div class="flex gap-1" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <Heart size={15} color="#DD2530" />
                  ))}
                </div>
                <blockquote class="mt-6 flex-1 font-serif text-xl italic leading-relaxed text-ink/80 sm:text-2xl">
                  “{t.quote}”
                </blockquote>
                <figcaption class="mt-6 w-full border-t border-brand-soft pt-5">
                  <span class="font-semibold text-brand">{t.name}</span>
                  <span class="block text-sm text-ink/50">{t.place}</span>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      {
        showControls && (
          /* Los controles van debajo, no encima de la cita: sobre texto las
             flechas flotantes taparían justo lo que hay que leer. */
          <div class="relative mt-8 flex items-center justify-center gap-4">
            <button
              type="button"
              data-prev
              aria-label="Testimonio anterior"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-brand-soft bg-white text-brand shadow-sm transition-colors hover:bg-brand-soft"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>

            <div class="flex items-center gap-2">
              {testimonials.map((_, i) => (
                <button
                  type="button"
                  data-dot
                  aria-label={`Ir al testimonio ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  class="tst-dot h-2 rounded-full bg-brand/25 transition-all"
                />
              ))}
            </div>

            <button
              type="button"
              data-next
              aria-label="Testimonio siguiente"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-brand-soft bg-white text-brand shadow-sm transition-colors hover:bg-brand-soft"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>

            {/* Absoluto para no descentrar el trío anterior/puntos/siguiente.
                El aria-label y el aria-pressed los mantiene carousel.ts */}
            <button
              type="button"
              data-play-toggle
              aria-label="Pausar el paso automático"
              aria-pressed="false"
              class="absolute right-0 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-ink/35 transition-colors hover:text-brand"
            >
              <svg class="icon-pause h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
              </svg>
              <svg class="icon-play hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5l11 7-11 7z" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* El track se desplaza, pero sin barra visible */
  .tst-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .tst-track::-webkit-scrollbar {
    display: none;
  }

  .tst-dot {
    width: 0.5rem;
  }
  .tst-dot[aria-current='true'] {
    width: 1.5rem;
    background-color: var(--color-brand);
  }
</style>

<script>
  import { initCarousels } from '../scripts/carousel';

  // Un poco más lento que el del hero: leer una cita cuesta más que ver una foto.
  initCarousels('[data-testimonials]', { autoplayMs: 7000 });
</script>
