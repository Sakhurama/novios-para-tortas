---
import { waLink, WHATSAPP_DATE_LINE } from '../config';
import Heart from './Heart.astro';
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import SectionTitle from './SectionTitle.astro';

// Cada paso lleva su icono de línea (ver Icon.astro) dentro de un círculo, con
// el número en una insignia encima: se entiende de un vistazo sin leer el texto.
const steps = [
  {
    n: '01',
    icon: 'catalogo' as const,
    title: 'Mira los modelos',
    desc: 'Elige uno como punto de partida o cuéntanos una idea desde cero. Las dos cosas valen.',
  },
  {
    n: '02',
    icon: 'chat' as const,
    title: 'Cuéntanos cómo son',
    desc: 'Mándanos una foto de ustedes por WhatsApp y dinos el vestido, el traje, el peinado, los colores...',
  },
  {
    n: '03',
    icon: 'aprobado' as const,
    // Este paso decía "Aprobamos juntos" sin explicar qué se aprueba. Que la
    // clienta vea la pieza terminada ANTES de que salga del taller es la mejor
    // promesa del proceso y no estaba escrita en ninguna parte de la web.
    title: 'Te mandamos la foto',
    desc: 'Cuando estén listos te mandamos la foto. Si algo no te convence, lo ajustamos antes de empacar.',
  },
  {
    n: '04',
    icon: 'envio' as const,
    title: 'Te llegan a casa',
    desc: 'Los empacamos reforzados y salen para tu ciudad. Lo demás es ponerlos arriba.',
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Cómo funciona"
      title="Así de <span class='italic'>sencillo</span>"
      subtitle="Cuatro pasos y todos por WhatsApp. Aquí no hay formularios ni carrito de compras."
    />

    <div
      data-reveal-group
      class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4"
    >
      {
        steps.map((s, i) => (
          <div class="relative">
            <span class="relative flex h-16 w-16 items-center justify-center rounded-full bg-brand-soft">
              <Icon name={s.icon} size={28} color="#490A41" />
              <span class="absolute -right-1 -top-1 flex h-7 w-7 items-center justify-center rounded-full bg-brand font-serif text-sm font-semibold text-white">
                {s.n}
              </span>
            </span>
            <h3 class="mt-5 font-serif text-xl font-semibold text-brand">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/80">{s.desc}</p>
            {/* Hilo punteado con un corazón que encadena un paso con el siguiente. */}
            {i < steps.length - 1 && (
              <span
                aria-hidden="true"
                class="absolute -right-6 left-[4.75rem] top-8 hidden items-center gap-2 lg:flex"
              >
                <span class="flex-1 border-t border-dashed border-brand/25" />
                <Heart size={12} color="#DD2530" class="opacity-40" />
                <span class="flex-1 border-t border-dashed border-brand/25" />
              </span>
            )}
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-14 text-center">
      <a
        href={waLink(`¡Hola! Ya vi cómo funciona y quiero empezar mi pedido de novios para torta 💍${WHATSAPP_DATE_LINE}`)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-medium text-white shadow-md transition-all hover:bg-brand-light hover:shadow-lg"
      >
        <WhatsAppIcon size={18} />
        ¡Comencemos!
      </a>
    </div>
  </div>
</section>
