---
import { waLink } from '../config';
import Heart from './Heart.astro';
import SectionTitle from './SectionTitle.astro';

const steps = [
  {
    n: '01',
    title: 'Elige tu modelo',
    desc: 'Explora el catálogo e inspírate. ¿Quieres algo único? También lo creamos desde cero.',
  },
  {
    n: '02',
    title: 'Cuéntanos los detalles',
    desc: 'Por WhatsApp nos dices cómo son ustedes: colores, vestuario, peinados y esos toques especiales.',
  },
  {
    n: '03',
    title: 'Aprobamos juntos',
    desc: 'Te confirmamos diseño, tiempos y envío. Trabajamos a mano tu pedido con todo el cuidado.',
  },
  {
    n: '04',
    title: 'Recíbelo en casa',
    desc: 'Empacamos con seguridad y enviamos a toda Colombia. Solo queda coronar tu torta.',
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Cómo funciona"
      title="Pedir tus novios es <span class='italic'>muy fácil</span>"
      subtitle="Un proceso cercano y sin complicaciones, de principio a fin, siempre acompañados por WhatsApp."
    />

    <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <div class="relative">
            <span class="font-serif text-5xl font-semibold text-brand-soft">{s.n}</span>
            <h3 class="mt-2 font-serif text-xl font-semibold text-brand">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{s.desc}</p>
            {i < steps.length - 1 && (
              <Heart size={14} color="#DD2530" class="absolute -right-1 top-4 hidden opacity-30 lg:block" />
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-medium text-white shadow-md transition-all hover:bg-brand-light hover:shadow-lg"
      >
        <Heart size={16} color="#ffffff" />
        Empieza tu pedido ahora
      </a>
    </div>
  </div>
</section>
