---
import { Image } from 'astro:assets';
import { waLink } from '../config';
import SectionTitle from './SectionTitle.astro';
import clasicos from '../assets/catalogo/clasicos.jpg';
import tematicos from '../assets/catalogo/tematicos.jpg';
import aniversarios from '../assets/catalogo/aniversarios.png';

const products = [
  {
    name: 'Novios Clásicos',
    desc: 'La pareja tradicional, elegante y atemporal. El favorito de siempre.',
    image: clasicos,
    alt: 'Novios clásicos hechos a mano bajo un arco de rosas rosadas',
  },
  {
    name: 'Temáticos',
    desc: 'Hobbies, profesiones, mascotas… un guiño único a lo que los une.',
    image: tematicos,
    alt: 'Novios personalizados con sus dos perros golden retriever a los pies',
  },
  {
    name: 'Aniversarios',
    desc: 'Bodas de plata, oro y más. Para seguir celebrando el amor.',
    image: aniversarios,
    alt: 'Pareja de esposos mayores coronando una torta blanca de aniversario',
  },
];
---

<section id="catalogo" class="bg-white">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Nuestro catálogo"
      title="Encuentra <span class='italic'>los novios</span> perfectos"
      subtitle="Cada modelo se elabora a mano y se puede personalizar. Elige el que más te enamore y cotízalo por WhatsApp sin compromiso."
    />

    <div data-reveal-group class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-brand-soft bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
            {/* Las fotos son verticales: 4/5 recorta lo mínimo. */}
            <div class="relative aspect-[4/5] overflow-hidden bg-brand-soft">
              <Image
                src={p.image}
                alt={p.alt}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-serif text-2xl font-semibold text-brand">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/60">{p.desc}</p>
              <a
                href={waLink(`¡Hola! Me interesan los "${p.name}". ¿Me ayudan a cotizarlos? 💍`)}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent"
              >
                Cotizar por WhatsApp
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
