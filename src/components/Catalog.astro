---
import { Image } from 'astro:assets';
import { waLink } from '../config';
import SectionTitle from './SectionTitle.astro';
import { formatCOP, hasPrices, products } from '../data/products';

// El "desde" no puede leerse como precio cerrado: cada figura se cotiza según
// lo que se personalice. La aclaración solo aparece si hay precios cargados.
const subtitle = hasPrices
  ? 'Cada modelo se elabora a mano y se puede personalizar. Los precios son de partida: el valor final depende de la personalización que elijas.'
  : 'Cada modelo se elabora a mano y se puede personalizar. Elige el que más te enamore y cotízalo por WhatsApp sin compromiso.';
---

<section id="catalogo" class="bg-white">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Nuestro catálogo"
      title="Encuentra <span class='italic'>los novios</span> perfectos"
      subtitle={subtitle}
    />

    <div data-reveal-group class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-brand-soft bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
            {/* Las fotos son verticales: 4/5 recorta lo mínimo. */}
            <div class="relative aspect-[4/5] overflow-hidden bg-brand-soft">
              <Image
                src={p.image}
                alt={p.alt}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-2xl font-semibold text-brand">{p.name}</h3>
                {p.priceFrom !== null && (
                  <span class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-xs font-semibold whitespace-nowrap text-brand">
                    Desde {formatCOP(p.priceFrom)}
                  </span>
                )}
              </div>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/60">{p.desc}</p>
              <a
                href={waLink(`¡Hola! Me interesan los "${p.name}". ¿Me ayudan a cotizarlos? 💍`)}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent"
              >
                Cotizar por WhatsApp
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
