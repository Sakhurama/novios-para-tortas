---
import { waLink } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  data-wa-fab
  class="group fixed bottom-5 right-5 z-50 flex max-sm:hidden items-center gap-2 rounded-full bg-[#25D366] px-5 py-3.5 text-white shadow-lg transition-all hover:scale-105 hover:shadow-xl"
>
  <WhatsAppIcon size={22} class="shrink-0" />
  {/* Antes la etiqueta estaba oculta en móvil y solo se desplegaba al pasar el
      ratón por encima — un gesto que en un teléfono no existe. Es decir: en el
      dispositivo por el que entra casi todo el tráfico, el botón era un
      círculo verde sin explicación. Ahora el texto está siempre, y dice qué
      pasa al pulsarlo. En pantallas menores a sm el botón no se muestra. */}
  <span class="whitespace-nowrap text-sm font-medium">WhatsApp</span>
</a>
