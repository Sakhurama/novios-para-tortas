---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  galleryImageAlts,
  galleryImageNames,
  GALLERY_ALT_FALLBACK,
  GALLERY_NAME_FALLBACK,
  galleryMessage,
  hasInstagram,
  site,
  waLink,
} from '../config';
import Heart from './Heart.astro';
import SectionTitle from './SectionTitle.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

// Igual que el Hero: las fotos entran solas al soltarlas en src/assets/galeria/.
const modules = import.meta.glob<ImageMetadata>(
  '../assets/galeria/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
);

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, image]) => {
    const file = path.split('/').pop() ?? '';
    const name = galleryImageNames[file] ?? GALLERY_NAME_FALLBACK;
    return {
      image,
      alt: galleryImageAlts[file] ?? GALLERY_ALT_FALLBACK,
      // El enlace se arma aquí, en el servidor, y viaja en un data-* por foto.
      // Así lightbox.ts sigue sin saber nada del negocio: solo copia el valor
      // de la diapositiva activa al botón.
      wa: waLink(galleryMessage(name)),
    };
  });

const hasPhotos = photos.length > 0;
---

<section id="galeria" class="bg-cream" data-gallery>
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionTitle
      eyebrow="Galería"
      title="Novios que ya <span class='italic'>están en su casa</span>"
      subtitle="Todos salieron de este taller para una boda de verdad, y hoy siguen en la repisa de alguien. Toca cualquier foto para verla en grande y pedir una parecida."
    />

    {
      hasPhotos ? (
        // Masonry con columnas CSS: cada foto conserva su proporción real, que
        // aquí va desde casi cuadrada hasta muy vertical. Sin recortes.
        // El escalonado va más corto que el general: aquí hay muchas más
        // piezas y a 90ms la última llegaría demasiado tarde.
        <div data-reveal-group class="mt-14 columns-2 gap-4 [--reveal-step:60ms] lg:columns-3 xl:columns-4">
          {photos.map(({ image, alt }, i) => (
            // Botón y no <figure> con onclick: el detalle está en el modelado y
            // solo se aprecia en grande, así que ampliar tiene que funcionar
            // también con teclado.
            <button
              type="button"
              data-lightbox-open
              aria-label={`Ampliar foto ${i + 1} de ${photos.length}: ${alt}`}
              class="group mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-brand/10"
            >
              <Image
                src={image}
                alt={alt}
                widths={[300, 500, 700]}
                sizes="(min-width: 1280px) 18rem, (min-width: 1024px) 24vw, 45vw"
                loading="lazy"
                class="w-full transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </button>
          ))}
        </div>
      ) : (
        <div data-reveal-group class="mt-14 grid auto-rows-[180px] grid-cols-2 gap-4 [--reveal-step:60ms] sm:grid-cols-4">
          {Array.from({ length: 8 }).map((_, i) => (
            <div class="flex items-center justify-center rounded-2xl border border-dashed border-brand/20 bg-white">
              <div class="text-center text-brand/35">
                <Heart size={26} color="#DD2530" class="mx-auto opacity-40" />
                <p class="mt-2 text-[10px] font-medium uppercase tracking-widest">Foto {i + 1}</p>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {/* Al retirar los testimonios, la galería se quedó siendo la única prueba
        de que aquí se trabaja de verdad. Siete fotos no sostienen solas veinte
        años de oficio: el perfil sí, y además se actualiza sin tocar la web.
        Solo aparece si hay un perfil real detrás. */}
    {hasPhotos && hasInstagram && (
      <div data-reveal class="mt-12 text-center">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent"
        >
          Mira muchos más trabajos en Instagram
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </div>

  {
    hasPhotos && (
      <dialog data-lightbox class="lightbox" aria-label="Galería ampliada">
        <button type="button" data-lightbox-close class="lightbox__ctrl lightbox__close" aria-label="Cerrar la galería ampliada">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>

        {photos.length > 1 && (
          <button type="button" data-lightbox-prev class="lightbox__ctrl lightbox__prev" aria-label="Foto anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
        )}

        <div data-lightbox-stage class="lightbox__stage">
          {photos.map(({ image, alt, wa }) => (
            <Image
              src={image}
              alt={alt}
              data-lightbox-slide
              data-wa={wa}
              widths={[700, 1000, 1400]}
              sizes="(min-width: 1024px) 60vw, 92vw"
              loading="lazy"
              class="lightbox__img"
            />
          ))}
        </div>

        {/* El cierre de la galería.
            Aquí es donde el deseo está más alto —alguien acaba de ampliar una
            foto para mirarla de cerca— y hasta ahora no había nada que pulsar.
            El enlace lo reapunta lightbox.ts a cada cambio de foto, así que el
            chat le llega al taller diciendo de qué pieza habla el cliente.
            Va dentro del <dialog>, de modo que entra solo en la trampa de foco
            nativa: no hay que tocar nada de accesibilidad. */}
        <a
          data-lightbox-cta
          href={photos[0].wa}
          target="_blank"
          rel="noopener"
          class="lightbox__cta"
        >
          <WhatsAppIcon size={20} />
          Quiero unos así
        </a>

        {photos.length > 1 && (
          <button type="button" data-lightbox-next class="lightbox__ctrl lightbox__next" aria-label="Foto siguiente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        )}

        {photos.length > 1 && (
          <p data-lightbox-counter class="lightbox__counter" aria-live="polite" />
        )}

      </dialog>
    )
  }
</section>

<style>
  .lightbox {
    /* El <dialog> trae márgenes y borde propios del navegador */
    margin: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    /* --color-brand con alfa; las variables del @theme no llegan a ::backdrop */
    background-color: rgb(30 6 26 / 0.88);
    backdrop-filter: blur(4px);
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    /* Abajo hay más aire que arriba: es el carril del CTA. */
    padding: 3.5rem 1rem 7rem;
  }

  .lightbox__img {
    display: none;
    max-width: min(92vw, 60rem);
    /* El 72vh es el tope cómodo, pero en una pantalla baja —un móvil apaisado—
       la foto más el carril del CTA no caben y el <dialog>, que recorta, se
       comería el botón. El calc es el suelo: deja siempre las 11rem que suman
       el aire de arriba y el carril de abajo. */
    max-height: min(72vh, calc(100vh - 11rem));
    width: auto;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
  }

  .lightbox__img.is-active {
    display: block;
  }

  .lightbox__ctrl {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    width: 2.75rem;
    border-radius: 9999px;
    color: #ffffff;
    background-color: rgb(255 255 255 / 0.12);
    transition: background-color 200ms;
  }

  .lightbox__ctrl:hover {
    background-color: rgb(255 255 255 / 0.24);
  }

  /* El foco global es morado y aquí el fondo es casi negro */
  .lightbox__ctrl:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .lightbox__ctrl svg {
    height: 1.5rem;
    width: 1.5rem;
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev {
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__next {
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* El contador se muda arriba a la izquierda, enfrente del aspa: abajo, en el
     centro, manda ahora el botón. */
  .lightbox__counter {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: rgb(255 255 255 / 0.7);
  }

  /* El CTA del visor. Verde de WhatsApp y no morado de marca a propósito: sobre
     un fondo casi negro es el color que se reconoce al instante, y reconocerlo
     es justo lo que baja el miedo a pulsar. */
  .lightbox__cta {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    padding: 0.875rem 1.5rem;
    border-radius: 9999px;
    background-color: #25d366;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.5);
    transition:
      background-color 200ms,
      transform 200ms;
  }

  .lightbox__cta:hover {
    background-color: #1ebe5a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox__cta:hover {
      transform: translateX(-50%) scale(1.04);
    }
  }

  .lightbox__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* En pantallas estrechas las flechas laterales y el botón se disputan la
     franja de abajo. El botón gana: las flechas suben al centro vertical de la
     foto, que es donde ya estaban, y el carril inferior queda libre. */
  @media (max-width: 30rem) {
    .lightbox__cta {
      bottom: 1rem;
      padding: 0.8125rem 1.25rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 220ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    @keyframes lightbox-in {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
    }
  }
</style>

<script>
  import { initLightbox } from '../scripts/lightbox';

  initLightbox('[data-gallery]');
</script>
