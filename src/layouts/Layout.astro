---
import '../styles/global.css';
import { site, socialProfiles, WHATSAPP_E164, WHATSAPP_NUMBER } from '../config';
import { faqs } from '../data/faqs';
import { formatCOP, hasPrice, PRICE_FROM, products } from '../data/products';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas de error no deben indexarse ni salir en el sitemap. */
  noindex?: boolean;
}

// La marca va al final y la búsqueda al principio: nadie teclea "Novios para
// Tortas" —todavía no saben que existe—, teclean lo que quieren comprar.
// La descripción lleva el precio porque es lo que más hace clicar en unos
// resultados donde ningún competidor lo enseña; sale de PRICE_FROM para que no
// se quede desfasado el día que cambie.
const precioMeta = hasPrice && PRICE_FROM !== null ? ` Desde ${formatCOP(PRICE_FROM)} la pareja.` : '';

const {
  title = `Novios para torta de matrimonio hechos a mano en Colombia | ${site.name}`,
  description = `Figuras de novios modeladas a mano en porcelanicrón, parecidas a ustedes: el peinado, el vestido, el traje y hasta el perro.${precioMeta} Taller en ${site.city} con ${site.yearsInMarket} años y envíos a toda Colombia. Cotiza por WhatsApp.`,
  noindex = false,
} = Astro.props;

// `Astro.site` sale de `site` en astro.config.mjs. WhatsApp y Facebook ignoran
// las URLs relativas en Open Graph, así que todas estas tienen que ser absolutas.
const canonical = new URL(Astro.url.pathname, Astro.site);
// El nombre lo fija scripts/generate-og.mjs; ahí está explicado por qué lleva
// número de versión en vez de llamarse og.jpg a secas.
const ogImage = new URL('/og-2.jpg', Astro.site);
const ogImageAlt = `${site.name} — novios hechos a mano para torta de matrimonio`;

// --- Datos estructurados ---------------------------------------------------
// `sameAs` solo acepta perfiles reales, y de eso se encarga `socialProfiles`
// en config.ts: mientras las redes sigan siendo los placeholders
// (`https://instagram.com/` a secas), declararlas sería decirle a Google que la
// marca es la portada de Instagram. La comprobación se mudó allí porque ahora
// la comparten este esquema, el pie y la galería.

// Se usa Organization y no LocalBusiness: el negocio es un taller sin tienda ni
// dirección de calle pública, y un LocalBusiness sin `address` completa genera
// avisos en Google. Aun así declaramos la localidad (ciudad + departamento +
// país) sin calle: es una señal geográfica válida que ayuda a que Google asocie
// la marca a Colombia y no a otro país hispanohablante. `areaServed` cubre el
// alcance nacional de los envíos.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('#organizacion', Astro.site).href,
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/logo-morado.png', Astro.site).href,
  image: ogImage.href,
  description,
  slogan: site.tagline,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'CO',
  },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  // El WhatsApp es el único canal de contacto del negocio, así que va tanto en
  // `telephone` (el campo que lee Google) como en un `contactPoint` que apunta
  // al chat: es lo que convierte, no una llamada.
  telephone: WHATSAPP_E164,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: WHATSAPP_E164,
    url: `https://wa.me/${WHATSAPP_NUMBER}`,
    areaServed: 'CO',
    availableLanguage: 'Spanish',
  },
  ...(socialProfiles.length > 0 && { sameAs: socialProfiles }),
};

// Las 5 preguntas ya escritas califican para resultado enriquecido. Salen de
// src/data/faqs.ts, el mismo origen que pinta la sección visible.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// El catálogo solo se declara cuando hay precios reales: un `Product` sin
// `offers` genera avisos de campo faltante en el test de Google. En cuanto se
// carguen los precios en src/data/products.ts, esto se activa solo.
const catalogSchema = hasPrice && PRICE_FROM !== null
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Catálogo de ${site.name}`,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Product',
          name: p.name,
          description: p.desc,
          image: new URL(p.image.src, Astro.site).href,
          brand: { '@type': 'Brand', name: site.name },
          // Los tres modelos parten de la misma pareja básica, así que
          // comparten `lowPrice`. Es `AggregateOffer` y no `Offer` justamente
          // porque no hay precio cerrado: el valor final depende de lo que se
          // le añada, y eso es lo que la página dice en voz alta.
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'COP',
            lowPrice: PRICE_FROM,
            availability: 'https://schema.org/InStock',
          },
        },
      })),
    }
  : null;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6D2064" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Señales geográficas: refuerzan que el negocio es de Colombia (Bucaramanga,
         Santander). No pesan tanto como el schema o un perfil de Google Business,
         pero son estándar y cuestan dos líneas. -->
    <meta name="geo.region" content={site.regionCode} />
    <meta name="geo.placename" content={site.city} />

    <!-- Open Graph: es lo que decide cómo se ve el enlace al pegarlo en un
         chat de WhatsApp, que es por donde entra todo el negocio. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage.href} />
    <!-- `secure_url` y `type` son redundantes sobre el papel, pero el scraper de
         Meta es quisquilloso: hay versiones que leen `secure_url` con preferencia
         sobre `og:image`, y sin `type` a veces descarta la imagen antes de
         llegar a descargarla. Cuestan dos líneas. -->
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fuentes: serif elegante (títulos) + sans limpia (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Marca el documento antes del primer pintado: el CSS de entrada solo
         esconde si existe esta clase, así que sin JS no se oculta nada.
         Tiene que ser is:inline; si Astro lo empaquetara como módulo correría
         después de pintar y el contenido aparecería para esconderse luego. -->
    <script is:inline>
      document.documentElement.classList.add('js-anim');
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    {
      catalogSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(catalogSchema)} />
      )
    }

    <Analytics />
  </head>
  <body>
    <!-- Primer tabulador de la página: deja saltarse el navbar entero. -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
    >
      Saltar al contenido
    </a>

    <slot />

    <script>
      import { initReveal } from '../scripts/reveal';
      import { initWhatsAppTracking } from '../scripts/analytics';

      initReveal();
      initWhatsAppTracking();
    </script>
  </body>
</html>
