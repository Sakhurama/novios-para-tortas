---
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · Novios artesanales para torta de matrimonio`,
  description = `Fabricamos a mano las figuras de novios que coronan tu torta de matrimonio. ${site.yearsInMarket} años de tradición familiar en Colombia. Cotiza por WhatsApp.`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#6D2064" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />

    <!-- Fuentes: serif elegante (títulos) + sans limpia (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Marca el documento antes del primer pintado: el CSS de entrada solo
         esconde si existe esta clase, así que sin JS no se oculta nada.
         Tiene que ser is:inline; si Astro lo empaquetara como módulo correría
         después de pintar y el contenido aparecería para esconderse luego. -->
    <script is:inline>
      document.documentElement.classList.add('js-anim');
    </script>
  </head>
  <body>
    <slot />

    <script>
      import { initReveal } from '../scripts/reveal';

      initReveal();
    </script>
  </body>
</html>
